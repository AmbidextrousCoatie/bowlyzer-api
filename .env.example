# Host path to published Parquet from bowlyzer_deploy (read-only mount).
# Docker Compose interpolates this into the import service volume.
BOWLYZER_PARQUET_DIR=../bowlyzer_deploy/database/data

BOWLYZER_HOST_PORT=8080

